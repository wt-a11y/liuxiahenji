# Python 字节码 / 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境
venv/
env/
.venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.local

# 测试 / 调试输出
.pytest_cache/
.coverage
htmlcov/
*.log

# === sessions/ 目录 ===
# 保留 sessions/ 目录本身，但忽略其下运行产生的数据文件
sessions/*.csv
sessions/*.json
sessions/*.txt

# 仅保留目录占位文件
!sessions/.gitkeep